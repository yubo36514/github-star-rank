# ====== 应用基础配置 ======
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=1
LOG_LEVEL=INFO

# ====== 数据库（SQLite）======
# 容器内部署时建议使用绝对路径：sqlite+aiosqlite:////app/data/app.db
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# ====== Github 官方 API ======
# 强烈建议填写 Personal Access Token（fine-grained / classic 均可以只读权限），
# 未认证请求仅 60 次/小时，认证后 5000 次/小时。
# 示例值留空：请填入自己的 Token，切勿把真实 Token 提交到仓库
GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com
# 两次请求之间的最小间隔（秒），用于规避 Github secondary rate limit
GITHUB_REQUEST_INTERVAL=0.7
# 候选池最大仓库数
GITHUB_MAX_REPOS=500
# Search API 每个查询最多翻多少页（每页 100 条）
GITHUB_SEARCH_PAGES=5
# 剩余配额低于该值时停止本轮抓取
GITHUB_RATE_LIMIT_THRESHOLD=50
# 接口响应缓存时间（秒）——用于减少对 Github API 的重复请求
GITHUB_CACHE_TTL=21600
# 新收录仓库是否用 stargazers 时间线接口估算近 7 日增量（会消耗额外配额）
GITHUB_BACKFILL_STARGAZERS=true
GITHUB_BACKFILL_LIMIT=30

# ====== 定时任务（UTC 小时；Asia/Shanghai = UTC+8）======
# 0    -> 北京时间 08:00 抓取快照
# 1    -> 北京时间 09:00 计算 7 日增量
# 每周一 03:00 清理过期快照
FETCH_CRON_HOUR=0
DELTA_CRON_HOUR=1
CLEANUP_CRON_HOUR=19
SNAPSHOT_RETENTION_DAYS=90

# ====== 管理接口鉴权 ======
# POST /api/v1/admin/refresh 需要 Header: X-Admin-Token
# 示例值：务必改成自己的强随机串，默认值公开在仓库中会被滥用
ADMIN_TOKEN=your-strong-admin-token

# ====== 其它 ======
# 允许的前端来源，多个用逗号分隔；* 表示全部
CORS_ORIGINS=*
# 数据库为空时自动写入演示数据（方便一键启动后立即看到效果）
DEMO_SEED_ON_EMPTY=true
